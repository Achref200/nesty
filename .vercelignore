# The production build is generated by scripts/vercel-build.sh on Vercel.
/.dart_tool/
/build/

# The Nesty app deploys as Flutter Web; native targets and the separate
# marketing site are not part of this Vercel project.
/android/
/ios/
/linux/
/macos/
/windows/
/website/
/services/
/test/
/supabase/

# Keep local credentials and machine-specific tooling out of deployment uploads.
dart_defines.json
**/dart_defines.json
.env
.env.*
/.autoclaw/
/.claude/
/.clinerules/
/.idea/
/.vscode/
