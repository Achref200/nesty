# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings → API.
# Never commit `.env.local` — it is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key (sb_publishable_...). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT is also accepted if you prefer:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
